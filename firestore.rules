rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Email/password accounts must confirm ownership of the address before
    // they can access private data or create any shared Friend records.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validFriendCode(code) {
      return code is string && code.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{8}$');
    }

    function friendshipKey(uidA, uidB) {
      return uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA;
    }

    function areFriends(uidA, uidB) {
      let key = friendshipKey(uidA, uidB);
      return uidA != uidB && exists(/databases/$(database)/documents/friendships/$(key));
    }

    // Profile pictures are compressed JPEG data URLs produced in the browser.
    // Do not permit arbitrary remote URLs in public profile data.
    function validProfilePhoto(photoURL) {
      return photoURL is string
        && photoURL.size() <= 300000
        && (photoURL == ''
          || photoURL.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'));
    }

    function validPublicProfile(data) {
      return data.keys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        && data.keys().hasAll(['displayName', 'photoURL', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 60
        && validProfilePhoto(data.photoURL)
        && data.updatedAt == request.time;
    }

    function validPrivateProfilePhoto(data) {
      return !('photoURL' in data) || validProfilePhoto(data.photoURL);
    }

    // A private users/{uid} document may be created before Friend Code setup
    // completes, but once a code exists it cannot be removed or changed.
    function validNewPrivateProfile(userId) {
      return validPrivateProfilePhoto(request.resource.data)
        && (!('friendCode' in request.resource.data)
          || (validFriendCode(request.resource.data.friendCode)
            && existsAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode))
            && getAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode)).data.uid == userId));
    }

    function validPrivateProfileUpdate(userId) {
      return validPrivateProfilePhoto(request.resource.data)
        && (!('friendCode' in resource.data)
          ? validNewPrivateProfile(userId)
          : ('friendCode' in request.resource.data
            && request.resource.data.friendCode == resource.data.friendCode));
    }

    function validTmdbImagePath(path) {
      return path == null || (path is string
        && path.size() <= 255
        && path.matches('^/[A-Za-z0-9._-]+$'));
    }

    function validRating(rating) {
      return rating == null
        || rating == 'hot'
        || rating == 'good'
        || rating == 'okay'
        || rating == 'bad';
    }

    function validTmdbMeta(meta) {
      return meta is map
        && meta.keys().hasOnly(['numberOfSeasons', 'numberOfEpisodes', 'tmdbStatus', 'episodeRuntime'])
        && meta.keys().hasAll(['numberOfSeasons', 'numberOfEpisodes', 'tmdbStatus', 'episodeRuntime'])
        && meta.numberOfSeasons is int
        && meta.numberOfSeasons >= 0
        && meta.numberOfSeasons <= 1000
        && meta.numberOfEpisodes is int
        && meta.numberOfEpisodes >= 0
        && meta.numberOfEpisodes <= 100000
        && meta.tmdbStatus is string
        && meta.tmdbStatus.size() <= 120
        && (meta.episodeRuntime == null || (meta.episodeRuntime is int
          && meta.episodeRuntime >= 1
          && meta.episodeRuntime <= 1440));
    }

    // Rules cannot iterate a list of season maps. The client separately
    // normalizes every season before rendering, while this rule bounds the
    // shared document and validates all executable/rendered top-level fields.
    function validLibraryItem(data) {
      return data.keys().hasOnly([
          'tmdbId', 'title', 'poster', 'backdrop', 'status', 'rating',
          'seasons', 'tmdbMeta', 'addedAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'tmdbId', 'title', 'poster', 'backdrop', 'status', 'rating',
          'seasons', 'tmdbMeta', 'addedAt', 'updatedAt'
        ])
        && data.tmdbId is int
        && data.tmdbId >= 1
        && data.tmdbId <= 2147483647
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 240
        && validTmdbImagePath(data.poster)
        && validTmdbImagePath(data.backdrop)
        && validRating(data.rating)
        && data.seasons is list
        && data.seasons.size() <= 100
        && validTmdbMeta(data.tmdbMeta)
        && data.addedAt is timestamp
        && data.updatedAt == request.time;
    }

    function validAnimeLibraryItem(data) {
      return validLibraryItem(data)
        && (data.status == 'watching'
          || data.status == 'planned'
          || data.status == 'comeback'
          || data.status == 'finished'
          || data.status == 'dropped');
    }

    function validSeriesLibraryItem(data) {
      return validLibraryItem(data)
        && (data.status == 'watching'
          || data.status == 'planned'
          || data.status == 'returning'
          || data.status == 'finished'
          || data.status == 'dropped');
    }

    function validFriendRequest(requestId) {
      let targetUid = request.resource.data.toUid;
      let oppositeRequestId = targetUid + '_' + request.auth.uid;
      let pairKey = friendshipKey(request.auth.uid, targetUid);
      return request.resource.data.keys().hasOnly([
          'fromUid', 'toUid', 'fromDisplayName', 'fromPhotoURL', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'fromUid', 'toUid', 'fromDisplayName', 'fromPhotoURL', 'createdAt'
        ])
        && request.resource.data.fromUid == request.auth.uid
        && targetUid is string
        && targetUid != request.auth.uid
        && requestId == request.auth.uid + '_' + targetUid
        && request.resource.data.fromDisplayName is string
        && request.resource.data.fromDisplayName.size() > 0
        && request.resource.data.fromDisplayName.size() <= 60
        && validProfilePhoto(request.resource.data.fromPhotoURL)
        && request.resource.data.createdAt == request.time
        // Copy public fields into a pending request; do not expose users/{uid}.
        && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && request.resource.data.fromDisplayName == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.displayName
        && request.resource.data.fromPhotoURL == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.photoURL
        && !exists(/databases/$(database)/documents/friendRequests/$(oppositeRequestId))
        && !exists(/databases/$(database)/documents/friendships/$(pairKey));
    }

    function validFriendship(friendshipDoc) {
      return request.resource.data.keys().hasOnly(['users', 'createdAt'])
        && request.resource.data.keys().hasAll(['users', 'createdAt'])
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] is string
        && request.resource.data.users[1] is string
        && request.resource.data.users[0] < request.resource.data.users[1]
        && friendshipDoc == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.createdAt == request.time;
    }

    // The recipient must delete the matching pending request in the same
    // atomic transaction/batch that creates the friendship. Either request
    // direction is supported even though the friendship UID order is fixed.
    function acceptanceDeletesPendingRequest() {
      let firstUid = request.resource.data.users[0];
      let secondUid = request.resource.data.users[1];
      let forwardId = firstUid + '_' + secondUid;
      let reverseId = secondUid + '_' + firstUid;
      return (
          exists(/databases/$(database)/documents/friendRequests/$(forwardId))
          && get(/databases/$(database)/documents/friendRequests/$(forwardId)).data.fromUid == firstUid
          && get(/databases/$(database)/documents/friendRequests/$(forwardId)).data.toUid == secondUid
          && request.auth.uid == secondUid
          && !existsAfter(/databases/$(database)/documents/friendRequests/$(forwardId))
        ) || (
          exists(/databases/$(database)/documents/friendRequests/$(reverseId))
          && get(/databases/$(database)/documents/friendRequests/$(reverseId)).data.fromUid == secondUid
          && get(/databases/$(database)/documents/friendRequests/$(reverseId)).data.toUid == firstUid
          && request.auth.uid == firstUid
          && !existsAfter(/databases/$(database)/documents/friendRequests/$(reverseId))
        );
    }

    // Friend codes are exact-document lookups only. Listing is deliberately
    // denied to prevent directory-style discovery or enumeration.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && validFriendCode(code)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        // A code is only claimed alongside the owner's immutable profile field.
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.friendCode == code;
      allow update, delete: if false;
    }

    // This is the only profile document another signed-in user can read. It
    // intentionally excludes TMDB keys, private settings, notifications, and
    // Friend Codes. Exact reads support the Friends UI; listing is denied.
    match /publicProfiles/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isOwner(userId) && validPublicProfile(request.resource.data);
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      // Allow a direct read of a missing deterministic request so a client
      // transaction can safely check its absence. Existing requests remain
      // visible only to their sender or recipient; collection scans stay gated.
      allow get: if signedIn() && (resource == null
        || request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow list: if signedIn()
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if signedIn() && validFriendRequest(requestId);
      allow update: if false;
      // Sender can cancel; recipient can reject or atomically accept.
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
    }

    match /friendships/{friendshipDoc} {
      // Direct reads of a missing canonical friendship are needed by the
      // request/accept transactions. They reveal no data; existing documents
      // are still visible only to one of the two accepted friends.
      allow get: if signedIn() && (resource == null || resource.data.users.hasAny([request.auth.uid]));
      allow list: if signedIn() && resource.data.users.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && validFriendship(friendshipDoc)
        && acceptanceDeletesPendingRequest();
      allow update: if false;
      allow delete: if signedIn() && resource.data.users.hasAny([request.auth.uid]);
    }

    match /users/{userId} {
      // The owner alone can access their private profile/settings document.
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && validNewPrivateProfile(userId);
      allow update: if isOwner(userId) && validPrivateProfileUpdate(userId);
      allow delete: if false;

      // Friends receive read-only access only after an accepted friendship
      // exists. Pending requests grant no library access.
      match /anime/{animeId} {
        allow get, list: if signedIn() && (request.auth.uid == userId || areFriends(request.auth.uid, userId));
        allow create, update: if isOwner(userId) && validAnimeLibraryItem(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /series/{seriesId} {
        allow get, list: if signedIn() && (request.auth.uid == userId || areFriends(request.auth.uid, userId));
        allow create, update: if isOwner(userId) && validSeriesLibraryItem(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Notifications remain private, including from accepted friends.
      match /notifications/{notificationId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }
  }
}
