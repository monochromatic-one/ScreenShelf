rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Email/password accounts must confirm ownership of the address before
    // using ScreenShelf, appearing in the directory, or viewing libraries.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Profile pictures are compressed JPEG data URLs produced in the browser.
    // Do not permit arbitrary remote URLs in public profile data.
    function validProfilePhoto(photoURL) {
      return photoURL is string
        && photoURL.size() <= 300000
        && (photoURL == ''
          || photoURL.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'));
    }

    // The directory contains only these public fields. It excludes emails,
    // private settings, notification data, and all authentication data.
    function validPublicProfile(data) {
      return data.keys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        && data.keys().hasAll(['displayName', 'photoURL', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 60
        && validProfilePhoto(data.photoURL)
        && data.updatedAt == request.time;
    }

    function validPrivateProfilePhoto(data) {
      return !('photoURL' in data) || validProfilePhoto(data.photoURL);
    }

    function validPrivateProfile() {
      return validPrivateProfilePhoto(request.resource.data);
    }

    function validTmdbImagePath(path) {
      return path == null || (path is string
        && path.size() <= 255
        && path.matches('^/[A-Za-z0-9._-]+$'));
    }

    function validRating(rating) {
      return rating == null
        || rating == 'hot'
        || rating == 'good'
        || rating == 'okay'
        || rating == 'bad';
    }

    function validTmdbMeta(meta) {
      return meta is map
        && meta.keys().hasOnly(['numberOfSeasons', 'numberOfEpisodes', 'tmdbStatus', 'episodeRuntime', 'tmdbVoteAverage', 'tmdbVoteCount', 'tmdbRefreshedAt'])
        && meta.keys().hasAll(['numberOfSeasons', 'numberOfEpisodes', 'tmdbStatus', 'episodeRuntime'])
        && meta.numberOfSeasons is int
        && meta.numberOfSeasons >= 0
        && meta.numberOfSeasons <= 1000
        && meta.numberOfEpisodes is int
        && meta.numberOfEpisodes >= 0
        && meta.numberOfEpisodes <= 100000
        && meta.tmdbStatus is string
        && meta.tmdbStatus.size() <= 120
        && (meta.episodeRuntime == null || (meta.episodeRuntime is int
          && meta.episodeRuntime >= 1
          && meta.episodeRuntime <= 1440))
        && (meta.tmdbVoteAverage == null || (meta.tmdbVoteAverage is number
          && meta.tmdbVoteAverage >= 0
          && meta.tmdbVoteAverage <= 10))
        && (meta.tmdbVoteCount == null || (meta.tmdbVoteCount is int
          && meta.tmdbVoteCount >= 0
          && meta.tmdbVoteCount <= 2147483647))
        && (meta.tmdbRefreshedAt == null || (meta.tmdbRefreshedAt is int
          && meta.tmdbRefreshedAt >= 0
          && meta.tmdbRefreshedAt <= 4102444800000));
    }

    function validCompanionMovies(data) {
      // Rules cannot iterate movie maps. The private client normalizes each
      // entry; these checks bound the document and keep its schema separate
      // from publicly readable library items.
      return data.keys().hasOnly(['mediaType', 'tmdbId', 'movies', 'updatedAt'])
        && data.keys().hasAll(['mediaType', 'tmdbId', 'movies', 'updatedAt'])
        && (data.mediaType == 'anime' || data.mediaType == 'show')
        && data.tmdbId is int
        && data.tmdbId >= 1
        && data.tmdbId <= 2147483647
        && data.movies is list
        && data.movies.size() <= 30
        && data.updatedAt == request.time;
    }

    // Rules cannot iterate a list of season maps. The client separately
    // normalizes every season before rendering, while this rule bounds the
    // publicly readable document and validates every top-level field.
    function validLibraryItem(data) {
      return data.keys().hasOnly([
          'tmdbId', 'title', 'poster', 'backdrop', 'status', 'rating',
          'seasons', 'tmdbMeta', 'addedAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'tmdbId', 'title', 'poster', 'backdrop', 'status', 'rating',
          'seasons', 'tmdbMeta', 'addedAt', 'updatedAt'
        ])
        && data.tmdbId is int
        && data.tmdbId >= 1
        && data.tmdbId <= 2147483647
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 240
        && validTmdbImagePath(data.poster)
        && validTmdbImagePath(data.backdrop)
        && validRating(data.rating)
        && data.seasons is list
        && data.seasons.size() <= 100
        && validTmdbMeta(data.tmdbMeta)
        && data.addedAt is timestamp
        && data.updatedAt == request.time;
    }

    function validAnimeLibraryItem(data) {
      return validLibraryItem(data)
        && (data.status == 'watching'
          || data.status == 'planned'
          || data.status == 'comeback'
          || data.status == 'finished'
          || data.status == 'dropped');
    }

    function validSeriesLibraryItem(data) {
      return validLibraryItem(data)
        && (data.status == 'watching'
          || data.status == 'planned'
          || data.status == 'returning'
          || data.status == 'finished'
          || data.status == 'dropped');
    }

    // Every verified ScreenShelf user appears in this directory. Public
    // entries deliberately contain just a display name and optional picture.
    match /publicProfiles/{userId} {
      allow get, list: if signedIn();
      allow create, update: if isOwner(userId) && validPublicProfile(request.resource.data);
      allow delete: if false;
    }

    match /users/{userId} {
      // Private account/profile data remains owner-only.
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && validPrivateProfile();
      allow delete: if false;

      // The chosen community model makes anime and series libraries readable
      // by every verified ScreenShelf account. They remain owner-write-only.
      match /anime/{animeId} {
        allow get, list: if signedIn();
        allow create, update: if isOwner(userId) && validAnimeLibraryItem(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /series/{seriesId} {
        allow get, list: if signedIn();
        allow create, update: if isOwner(userId) && validSeriesLibraryItem(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Notifications remain private.
      match /notifications/{notificationId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      // Companion movies remain private. They are never stored on the public
      // anime/series documents.
      match /companionMovies/{checklistId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && validCompanionMovies(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
